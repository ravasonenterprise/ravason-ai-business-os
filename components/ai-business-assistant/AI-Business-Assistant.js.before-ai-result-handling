const RavasonAIBusinessAssistant = {

    render() {

        const profile =
            RavasonBusinessProfileService.getProfile();

        return `

            <section class="module-workspace">

                <div class="module-header">

                    <div>

                        <span class="module-eyebrow">
                            RAVASON AI BUSINESS ASSISTANT
                        </span>

                        <h1>
                            Your AI Business Assistant
                        </h1>

                        <p>
                            Ask questions and get intelligent
                            business guidance based on your profile.
                        </p>

                    </div>

                    <button
                        class="secondary-action"
                        id="back-to-business-builder">

                        ← Back

                    </button>

                </div>


                <div
                    class="ai-consent-panel"
                    id="ai-consent-panel">

                    <h2>
                        AI Usage
                    </h2>

                    <p
                        id="ai-consent-status">
                        Checking AI availability...
                    </p>

                    <button
                        type="button"
                        class="secondary-action"
                        id="ai-consent-toggle">

                        Check AI Status

                    </button>

                </div>


                <div class="ai-assistant-context">

                    <h2>
                        Business Context
                    </h2>

                    <p>
                        ${
                            profile.businessName ||
                            "Your business"
                        }
                    </p>

                    <p>
                        ${
                            profile.industry ||
                            "Industry not set"
                        }
                    </p>

                </div>


                <div
                    class="ai-chat-container"
                    id="ai-chat-container">

                </div>


                <form
                    class="ai-chat-form"
                    id="ai-chat-form">

                    <input
                        type="text"
                        id="ai-chat-input"
                        placeholder="Ask Ravason AI anything..."
                        autocomplete="off"
                        required>

                    <button
                        type="submit"
                        class="primary-action">

                        Send

                    </button>

                </form>

            </section>

        `;

    },


    init() {

        const form =
            document.getElementById(
                "ai-chat-form"
            );

        const input =
            document.getElementById(
                "ai-chat-input"
            );

        const chat =
            document.getElementById(
                "ai-chat-container"
            );

        const backButton =
            document.getElementById(
                "back-to-business-builder"
            );


        const aiStatus =
            document.getElementById(
                "ai-consent-status"
            );


        const aiToggle =
            document.getElementById(
                "ai-consent-toggle"
            );


        const updateAIStatus = () => {

            const status =
                RavasonAIStatusService.getStatus();


            if (
                status.state ===
                "unavailable"
            ) {

                aiStatus.textContent =
                    status.message +
                    " AI is optional and your " +
                    "business can continue operating " +
                    "without AI.";

                aiToggle.textContent =
                    "AI Not Available";

                aiToggle.disabled =
                    true;

                return;

            }


            if (
                status.state ===
                "disabled"
            ) {

                aiStatus.textContent =
                    status.message +
                    " Enable AI only if you choose " +
                    "to use AI-powered features.";

                aiToggle.textContent =
                    "Enable AI";

                aiToggle.disabled =
                    false;

                return;

            }


            aiStatus.textContent =
                status.message;

            aiToggle.textContent =
                "Disable AI";

            aiToggle.disabled =
                false;

        };


        updateAIStatus();


        if (
            aiToggle
        ) {

            aiToggle.addEventListener(
                "click",
                () => {

                    const status =
                        RavasonAIStatusService.getStatus();


                    if (
                        !status.available
                    ) {

                        return;

                    }


                    if (
                        status.enabled
                    ) {

                        RavasonAIConsentService.disable();

                    } else {

                        RavasonAIConsentService.enable();

                    }


                    updateAIStatus();

                }

            );

        }


        if (backButton) {

            backButton.addEventListener(
                "click",
                () => {

                    window.RavasonRouter.navigate(
                        "business-builder"
                    );

                }

            );

        }


        if (
            form &&
            input &&
            chat
        ) {

            const messages =
                RavasonAIConversationService.getMessages();


            if (
                messages.length === 0
            ) {

                RavasonAIConversationService.addMessage(

                    "assistant",

                    "Hello! I am Ravason AI. " +
                    "How can I help you grow your business?"

                );

            }


            const conversation =
                RavasonAIConversationService.getMessages();


            conversation.forEach(

                (message) => {

                    const messageElement =
                        document.createElement(
                            "div"
                        );


                    messageElement.className =
                        message.role === "user"
                            ? "ai-message ai-message-user"
                            : "ai-message ai-message-assistant";


                    messageElement.textContent =
                        message.content;


                    chat.appendChild(
                        messageElement
                    );

                }

            );


            chat.scrollTop =
                chat.scrollHeight;


            form.addEventListener(
                "submit",
                async (event) => {

                    event.preventDefault();

                    const question =
                        input.value.trim();

                    if (!question) {

                        return;

                    }


                    const profile =
                        RavasonBusinessProfileService.getProfile();


                    const userMessage =
                        document.createElement(
                            "div"
                        );


                    userMessage.className =
                        "ai-message ai-message-user";


                    userMessage.textContent =
                        question;


                    chat.appendChild(
                        userMessage
                    );


                    const userMessageSaved =
                        RavasonAIConversationService.addMessage(

                            "user",

                            question

                        );

                    if (!userMessageSaved) {

                        console.error(
                            "User message failed to save."
                        );

                    }


                    input.value = "";


                    const aiResult =
                        RavasonAIService.ask({

                            question:

                                question,

                            businessProfile:

                                profile

                        });


                    const assistantResponse =
                        aiResult.response;


                    const assistantMessage =
                        document.createElement(
                            "div"
                        );


                    assistantMessage.className =
                        "ai-message ai-message-assistant";


                    assistantMessage.textContent =
                        assistantResponse;


                    chat.appendChild(
                        assistantMessage
                    );


                    const assistantMessageSaved =
                        RavasonAIConversationService.addMessage(

                            "assistant",

                            assistantResponse

                        );

                    if (!assistantMessageSaved) {

                        console.error(
                            "Assistant message failed to save."
                        );

                    }


                    chat.scrollTop =
                        chat.scrollHeight;

                }

            );

        }

    }

};


window.RavasonAIBusinessAssistant =
    RavasonAIBusinessAssistant;